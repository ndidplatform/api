{
  "name": "ndid-mq",
  "version": "9.1.0",
  "description": "",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "rm -rf build/ && npx babel src -d ./build/ --source-maps inline --verbose",
    "start": "npm run build && node build/server.js",
    "test": "npm run build && NODE_ID=unit-test npx mocha 'build/**/*.test.js' --node-option enable-source-maps",
    "test:es6": "NODE_ID=unit-test mocha 'src/**/*.test.js' ---require ./mocha-init.js --node-option enable-source-maps",
    "docker-build": "./docker/build.sh",
    "docker-up": "docker-compose -f docker/docker-compose.yml up",
    "docker-down": "docker-compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "ndid-error": "file:../ndid-error",
    "ndid-logger": "file:../ndid-logger",
    "prom-client": "^15.1.3",
    "source-map-support": "^0.5.21",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/eslint-plugin": "^7.27.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "eslint": "^8.57.1",
    "mocha": "^10.8.2"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "zeromq@6.5.0": true
  }
}
